# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI Gateway — use OIDC auth (vercel env pull provisions VERCEL_OIDC_TOKEN automatically)
# For non-Vercel environments, set AI_GATEWAY_API_KEY instead:
# AI_GATEWAY_API_KEY=your-gateway-key

# Widget (allowed origin for CORS)
ALLOWED_ORIGIN=https://elevateetiquette.com

# Ingestion endpoint auth (dedicated secret, NOT the service-role key)
# Generate: openssl rand -base64 32
INGEST_SECRET=your-ingest-secret

# Google OAuth (Gmail transcript delivery + subscriber Sheet)
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REFRESH_TOKEN=your-google-oauth-refresh-token
GOOGLE_SENDER_EMAIL=info@elevateetiquette.com
SUBSCRIBER_SHEET_ID=your-google-sheet-id
